# Shared Comment Database Configuration
# Copy this file to .env.local and fill in your values

# Database Connection (Required)
# Get this from your database provider (Neon, Supabase, Railway, etc.)
POSTGRES_URL=postgresql://username:password@host:5432/database

# Admin Panel Security (Required)
# Use a strong password for the admin panel at /comment
ADMIN_PASSWORD=your-secure-admin-password

# Comment Encryption (Required)
# Generate a random 32+ character string for encrypting sensitive data
COMMENT_ENCRYPTION_KEY=your-32-character-encryption-key

# Optional: Enable detailed logging
# NODE_ENV=development
