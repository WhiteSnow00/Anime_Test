# NextJS Anime Project - Environment Configuration Template
# Copy this file to .env.local and replace with your actual values

# MongoDB Configuration (REQUIRED)
# Replace with your secure MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=your-mongodb-connection-string-here
MONGODB_DB_NAME=anime_streaming

# MongoDB Connection Pool Configuration (OPTIMIZED FOR ATLAS)
MONGODB_MAX_POOL_SIZE=25
MONGODB_SERVER_SELECTION_TIMEOUT=15000
MONGODB_MAX_IDLE_TIME=1800000
MONGODB_SOCKET_KEEP_ALIVE=true

# Application Environment
NODE_ENV=development

# Admin Panel Security (REQUIRED)
# Use strong passwords - minimum 12 characters with mixed case, numbers, symbols
ADMIN_PASSWORD=your-secure-admin-password-here
MODERATOR_PASSWORD=your-secure-moderator-password-here

# Security Configuration (REQUIRED)
# Generate a random 32+ character string for encrypting sensitive data
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMMENT_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Performance Configuration
MONGODB_COMPRESSION=zlib
MONGODB_READ_PREFERENCE=primary

# Monitoring and Logging
ENABLE_DB_LOGGING=true
LOG_LEVEL=info

# Rate Limiting Configuration
COMMENT_RATE_LIMIT_WINDOW=300000
COMMENT_RATE_LIMIT_MAX=10

# Connection Health Check Settings
DB_HEALTH_CHECK_INTERVAL=30000
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_DELAY_BASE=1000

# SECURITY WARNING: 
# 1. Never commit .env.local to version control
# 2. Use unique, strong passwords for all accounts
# 3. Rotate credentials regularly
# 4. Use dedicated database users with minimal permissions
